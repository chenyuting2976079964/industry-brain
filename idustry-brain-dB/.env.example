# MySQL 远程访问配置
# 请将此文件重命名为 .env.local 并添加到 .gitignore 中，不要提交到版本控制

# MySQL root 用户密码（默认：root123）
MYSQL_ROOT_ROOT=root123

# 远程专用用户密码（生产环境请修改为强密码！）
MYSQL_REMOTE_USER_PASSWORD=RemotePass123!

# MySQL 绑定地址（0.0.0.0 = 允许所有接口，127.0.0.1 = 仅本地）
MYSQL_BIND_ADDRESS=0.0.0.0

# MySQL 端口映射（宿主:容器）
MYSQL_PORT=3307:3306
